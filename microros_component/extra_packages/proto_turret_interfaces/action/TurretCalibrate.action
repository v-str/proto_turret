# Калибровка турели: турель едет к левому концевику, затем к правому (считая
# шаги), затем возвращается в центр диапазона — середина считается 0°.
# То же самое делается для вертикали (передний/задний концевики).

# Goal
# (пусто — всегда калибруются обе оси)
---
# Result
bool success
uint32 pan_steps   # шаги полного хода панорамы (левый -> правый концевик)
uint32 tilt_steps  # шаги полного хода тильта (передний -> задний концевик)
---
# Feedback
uint8 stage  # 0 = старт, 1 = панорама, 2 = тильт